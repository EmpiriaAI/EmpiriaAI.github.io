{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empiriaai.github.io/schema/swe-trajectory.schema.json",
  "title": "swe-trajectory/1.0",
  "description": "One SWE agent rollout as consumed by trajectory-explorer.html and trajectory-dialogue.html. Every field is optional; a null renders as an omitted row. Fields marked x-status C are the written interface for data no producer emits yet.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/trajectory"
  },
  "$defs": {
    "trajectory": {
      "type": "object",
      "required": [
        "id",
        "trajectoryClass",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "shortId": {
          "type": "string",
          "description": "unique per run; the two-lane deep link is ?run=<shortId>"
        },
        "title": {
          "type": "string"
        },
        "trajectoryClass": {
          "const": "swe",
          "description": "omit and the page renders nothing"
        },
        "category": {
          "type": "string"
        },
        "taskType": {
          "type": "string"
        },
        "situation": {
          "enum": [
            "successful",
            "failed"
          ]
        },
        "score": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "site form: 'Reward 1.0'"
        },
        "valueTier": {
          "type": [
            "string",
            "null"
          ],
          "x-status": "C"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceTier": {
          "type": [
            "string",
            "null"
          ],
          "x-status": "C"
        },
        "dataSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshotLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshotOrdinal": {
          "type": [
            "integer",
            "null"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        },
        "messageCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "eventCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "toolCallCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "agentStepCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "estimatedTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errorRate": {
          "type": [
            "number",
            "null"
          ]
        },
        "captureCoverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokenUsageEstimated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "user": {
              "type": "integer"
            },
            "thinking": {
              "type": "integer"
            },
            "assistant": {
              "type": "integer"
            },
            "tool_call": {
              "type": "integer"
            },
            "tool_result": {
              "type": "integer"
            },
            "context": {
              "type": "integer"
            },
            "system": {
              "type": "integer"
            }
          }
        },
        "toolCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "tokenUsage": {
          "$ref": "#/$defs/tokenUsage"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "kindCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "events per kind; lets the reader's corpus overview rank runs without walking events"
        },
        "statusCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "tool_result statuses; 'missing' is excluded from the overview's fail-rate denominator"
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "description": "Both viewers draw a cachedInput/uncachedInput/output composition bar.",
      "properties": {
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cachedInput": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "uncachedInput": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "cacheWrite": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "thinkingTokens": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "promptTokens": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "rawInput": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "x-status": "C"
        },
        "serviceTier": {
          "type": [
            "string",
            "null"
          ],
          "x-status": "C"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "description": "Lets a viewer distinguish 'this run had no reasoning' from 'this producer does not record reasoning'.",
      "properties": {
        "schemaVersion": {
          "const": "swe-trajectory/1.0"
        },
        "producer": {
          "type": "string"
        },
        "commandsRecorded": {
          "type": "integer"
        },
        "commandsWithOutput": {
          "type": "integer"
        },
        "transcriptChars": {
          "type": "integer"
        },
        "transcriptTruncated": {
          "type": "boolean"
        },
        "available": {
          "type": "object",
          "properties": {
            "perStepTokens": {
              "type": "boolean"
            },
            "fullCommandOutput": {
              "type": "boolean"
            },
            "structuredRollout": {
              "type": "boolean"
            },
            "agentFinalDiff": {
              "type": "boolean"
            },
            "perTestResults": {
              "type": "boolean"
            },
            "relayEnvelope": {
              "type": "boolean"
            },
            "fileMutations": {
              "type": "boolean"
            },
            "samplingParams": {
              "type": "boolean"
            },
            "contextWindowPerStep": {
              "type": "boolean"
            },
            "eventTimestamps": {
              "type": [
                "boolean",
                "string"
              ]
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "system",
            "context",
            "thinking",
            "assistant",
            "tool_call",
            "tool_result"
          ],
          "description": "left lane: user/system/context/tool_result — right lane: thinking/assistant/tool_call"
        },
        "sourceIndex": {
          "type": "integer"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "success",
            "error",
            "timeout",
            "rejected",
            "missing",
            null
          ],
          "description": "error/timeout/rejected count as failures; 'missing' means the command ran but its output was never stored, and must NOT count as a failure"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "toolCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolName": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncatedInTrace": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "durationMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "stepMetrics": {
          "type": [
            "object",
            "null"
          ],
          "x-status": "C",
          "description": "highest-value missing field: renders a per-step token strip",
          "properties": {
            "prompt": {
              "type": "integer"
            },
            "cached": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "reasoning": {
              "type": "integer"
            }
          }
        },
        "filesChanged": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "x-status": "C"
        },
        "contextTokens": {
          "type": [
            "integer",
            "null"
          ],
          "x-status": "C"
        },
        "kind": {
          "type": "string",
          "enum": [
            "system",
            "inject",
            "user",
            "interrupt",
            "notify",
            "command",
            "context",
            "thinking",
            "assistant",
            "tool_call",
            "tool_result"
          ],
          "description": "exported explicitly; the reader derives it from content only for old snapshots"
        },
        "returnCode": {
          "type": [
            "integer",
            "null"
          ],
          "description": "0 when the harness reported success; null when unknown"
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Drives the Environment / Task / Verification panels and the two-lane run-source rail.",
      "properties": {
        "benchmark": {
          "type": [
